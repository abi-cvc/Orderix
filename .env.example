# ---------------------------------------------------------------------------
# Orderix: variables de entorno
# Copia este archivo como .env y completa los valores. El archivo .env NUNCA
# se sube al repositorio. Aquí solo van valores de ejemplo, ninguno real.
# ---------------------------------------------------------------------------

# Entorno de ejecución: development | test | production
NODE_ENV=development

# Dirección y puerto del servidor Node (Render define PORT automáticamente).
HOST=0.0.0.0
PORT=3000

# URL pública de la aplicación. Se usa para verificar el origen de los
# formularios (CSRF) y de las conexiones WebSocket.
APP_URL=http://localhost:3000

# Base de datos PostgreSQL.
# - DATABASE_URL: la usa la aplicación. En Neon, la cadena CON pooler (-pooler en el host).
# - DIRECT_URL: la usan las migraciones de Prisma. En Neon, la cadena directa (sin pooler).
# En local ambas apuntan al PostgreSQL de docker-compose.
DATABASE_URL=postgresql://orderix:orderix_local@localhost:5432/orderix
DIRECT_URL=postgresql://orderix:orderix_local@localhost:5432/orderix

# Confiar en el proxy inverso (true en Render). Sin esto, las cookies Secure
# no funcionan detrás del proxy.
TRUST_PROXY=false

# Secreto con el que el servidor firma los tokens CSRF de los formularios.
# Mínimo 32 caracteres aleatorios. Si cambia, los formularios abiertos dejan de valer.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-de-32-o-mas

# Duración de la sesión en horas.
SESSION_TTL_HOURS=8

# SOLO DESARROLLO: si tiene un rol (MESERO, COCINA, CAJERO, ADMINISTRADOR), las
# rutas protegidas usan un usuario falso con ese rol mientras el módulo de
# autenticación no esté listo. Vacío = desactivado. En producción se rechaza.
DEV_FAKE_USER_ROLE=

# Correo real para la recuperación de clave (Brevo, plan gratuito).
# Si BREVO_API_KEY está vacío, el enlace de recuperación se muestra en la
# consola del servidor (correo simulado). Nunca subas la clave al repositorio.
# CORREO_REMITENTE debe estar verificado como remitente en Brevo.
BREVO_API_KEY=
CORREO_REMITENTE=
CORREO_REMITENTE_NOMBRE=Orderix
